{
  "name": "Operator SDK",
  "build": { "dockerfile": "Dockerfile" },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "twxs.cmake",
        "ms-vscode.cmake-tools"
      ]
    }
  },
  "remoteUser": "dev",
  "postCreateCommand": "arm-none-eabi-gcc --version && pip install --break-system-packages -r ${containerWorkspaceFolder}/tools/requirements.txt"
}
